<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Plugin.Maui.OfflineSync.Sample"
             x:Class="Plugin.Maui.OfflineSync.Sample.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:DoneDecorationsConverter x:Key="DoneDecorationsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
