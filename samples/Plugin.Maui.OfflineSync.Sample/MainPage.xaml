<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Plugin.Maui.OfflineSync.Sample.Models"
             xmlns:vm="clr-namespace:Plugin.Maui.OfflineSync.Sample.ViewModels"
             x:Class="Plugin.Maui.OfflineSync.Sample.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Offline Sync">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
        <VerticalStackLayout Spacing="12">
            <Label Text="Plugin.Maui.OfflineSync"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Writes land locally first. Sync when you are ready."
                   TextColor="{StaticResource Gray500}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource Gray100}"
                        Padding="12,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="{Binding StatusText}" FontAttributes="Bold" />
                        <Label Text="{Binding PendingText}" TextColor="{StaticResource Gray500}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Button Grid.Column="1"
                        Text="{Binding ConnectivityLabel}"
                        Command="{Binding ToggleOnlineCommand}"
                        BackgroundColor="{StaticResource Tertiary}"
                        Padding="16,0" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="Add a note to sync later"
                       Text="{Binding NewTitle}"
                       ReturnCommand="{Binding AddCommand}" />
                <Button Grid.Column="1" Text="Add" Command="{Binding AddCommand}" />
            </Grid>

            <Button Text="Sync now"
                    Command="{Binding SyncCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <Label Text="Nothing stored yet. Add a note — it will stay on device until you sync."
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center"
                       Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid Padding="0,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   TextDecorations="{Binding IsDone, Converter={StaticResource DoneDecorationsConverter}}" />
                            <Label FontSize="12" TextColor="{StaticResource Gray500}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} · v{1}">
                                        <Binding Path="SyncState" />
                                        <Binding Path="Version" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Done"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleDoneCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="{StaticResource Tertiary}"
                                Padding="12,0" />
                        <Button Grid.Column="2"
                                Text="Delete"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#FEE2E2"
                                TextColor="#991B1B"
                                Padding="12,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
